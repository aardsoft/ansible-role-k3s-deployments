server:
  enabled: true

  image:
    repository: victoriametrics/victoria-logs

  podLabels:
    network/cluster-service: "true"

  # Retention period: accepts suffixes h (hours), d (days), w (weeks), y (years).
  retentionPeriod: {{cfg_values.retention_period|default('30d')}}

  persistentVolume:
    enabled: true
    storageClass: {{cfg_values.storage_class|default('longhorn')}}
    size: {{cfg_values.storage_size|default('10Gi')}}

  # Keep the in-cluster service as ClusterIP; external access is provided by
  # the separate LoadBalancer service created by the deploy task when loki_ip
  # is defined.
  service:
    type: ClusterIP

  extraArgs:
    # Log in JSON format for structured output.
    loggerFormat: json
    # Suppress noisy startup/shutdown messages from the flags library.
    envflag.enable: "true"
    envflag.prefix: VM_
    # Cap storage usage: the retention loop deletes oldest per-day partitions
    # until usage is under the cap, so a log burst cannot wedge the stack.
    # Without it, a full disk flips VictoriaLogs into read-only mode, which
    # also halts retention deletion — a full disk then stops defending itself.
    # Cap is in GiB, the flag wants bytes; it always keeps the newest 2 days
    # regardless of the cap.  Keep headroom below the PVC size for compaction.
    retention.maxDiskSpaceUsageBytes: "{{(cfg_values.retention_space_cap_gib|default(8)) | int * 1073741824}}"
